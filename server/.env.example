# Copy to .env and fill in. Never commit .env.
PORT=4000
NODE_ENV=development
# Public URL of the web app (used for redirects after WHOOP OAuth)
APP_URL=http://localhost:4000
# Extra allowed browser origins (comma separated) — Expo web dev server
CORS_ORIGINS=http://localhost:8081,http://localhost:8082
# 32+ random chars, used to encrypt third-party tokens at rest
TOKEN_ENC_KEY=change-me-to-a-long-random-string
# WHOOP developer app — https://developer-dashboard.whoop.com/
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:4000/api/integrations/whoop/callback
# Native deep link the app listens on after OAuth
NATIVE_REDIRECT=perigee://integrations
# AI tab (Claude). Gemini is used instead when GEMINI_API_KEY is set. Without a key the app uses offline answers.
ANTHROPIC_API_KEY=
# Optional: faster/cheaper model, e.g. claude-haiku-5-5 (default claude-opus-5-5)
COMPANION_MODEL=

# ---- Email verification (4-digit code sent to the user's inbox) ----
# on  = mandatory: sign-up/log-in fail with a clear error if no provider below is configured (the code is never shown)
# auto (default) = send real email when a provider is configured; an unconfigured dev server shows the code for demos
EMAIL_VERIFICATION=on
# Option A: Gmail SMTP with an App Password (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Option B: Resend (https://resend.com). Without a verified domain it can only email your own address.
RESEND_API_KEY=
# Test mode: print the email in the server console instead of sending it
# MAIL_TRANSPORT=json

CAMERA_STATION=off
