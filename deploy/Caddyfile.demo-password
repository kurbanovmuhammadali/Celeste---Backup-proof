# OPTION: the whole site behind one shared password (for a judges' demo with the demo shortcuts on).
# 1) caddy hash-password        -> paste the result below instead of HASH
# 2) cp this file over /etc/caddy/Caddyfile && sudo systemctl reload caddy
# The WHOOP callback, family links and their API stay open, because those people do not have the password.
celestasoft.health {
	encode zstd gzip
	@open path /api/integrations/whoop/callback /f/* /api/family/* /api/ice /_expo/* /assets/* /models/* /vendor/*
	@locked not path /api/integrations/whoop/callback /f/* /api/family/* /api/ice /_expo/* /assets/* /models/* /vendor/*
	basic_auth @locked {
		judge HASH
	}
	reverse_proxy 127.0.0.1:4000
}
