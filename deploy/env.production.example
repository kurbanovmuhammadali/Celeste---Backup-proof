# Copy to /opt/hmsc/server/.env on the VM and fill in. Never commit this file.
NODE_ENV=production
PORT=4000
APP_URL=https://celestasoft.health
# 32+ random characters: encrypts WHOOP tokens at rest (setup-vm.sh generates one if missing)
TOKEN_ENC_KEY=
# ---- sign-in codes by email (required in production) ----
EMAIL_VERIFICATION=on
# Option A: Gmail App Password        Option B: Resend (https://resend.com, verify celestasoft.health at Porkbun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HMSC <you@gmail.com>"
RESEND_API_KEY=
# ---- people who are flight surgeons (comma separated, must have an account) ----
ADMIN_EMAILS=bahromasurov708@gmail.com
# ---- WHOOP ----
WHOOP_CLIENT_ID=20dd2820-ae0e-44c7-ac89-694d4e9e6de7
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=https://celestasoft.health/api/integrations/whoop/callback
# ---- AI tab ----
GEMINI_API_KEY=
# ---- calls through strict firewalls (setup-turn.sh fills these in) ----
TURN_HOST=
TURN_SECRET=
# ---- demo shortcuts: keep OFF on a public server ----
DEMO_LOGIN=off
CAMERA_STATION=off
